# 复制为 .env 后按需修改：copy .env.example .env
# 参考值即为各字段在代码中的默认值，留空会回退到默认值。

# ==================== 服务器配置 ====================
HOST=0.0.0.0
PORT=5000

# ==================== 数据库配置(Insight Agent 私域检索，MySQL) ====================
# 表结构对应 MediaCrawler 的抖音/微博表：douyin_aweme / douyin_aweme_comment /
# weibo_note / weibo_note_comment
DB_DIALECT=mysql
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=media_crawler_v1
DB_CHARSET=utf8mb4

# ==================== LLM API 配置 ====================
# 四个角色各自独立配置，均为 OpenAI 兼容接口
# Insight Agent — 推荐 Kimi: https://platform.moonshot.cn/
INSIGHT_ENGINE_API_KEY=
INSIGHT_ENGINE_BASE_URL=https://api.moonshot.cn/v1
INSIGHT_ENGINE_MODEL_NAME=kimi-k2-0711-preview
INSIGHT_ENGINE_MODEL_PROVIDER=openai

# Media Agent — 推荐 Gemini / 通义千问等 OpenAI 兼容网关
MEDIA_ENGINE_API_KEY=
MEDIA_ENGINE_BASE_URL=https://aihubmix.com/v1
MEDIA_ENGINE_MODEL_NAME=gemini-2.5-pro
MEDIA_ENGINE_MODEL_PROVIDER=openai

# Report Agent
REPORT_ENGINE_API_KEY=
REPORT_ENGINE_BASE_URL=https://aihubmix.com/v1
REPORT_ENGINE_MODEL_NAME=gemini-2.5-pro
REPORT_ENGINE_MODEL_PROVIDER=openai

# Host Agent — 推荐 DeepSeek: https://www.deepseek.com/
HOST_API_KEY=
HOST_BASE_URL=https://api.deepseek.com
HOST_MODEL_NAME=deepseek-chat
HOST_MODEL_PROVIDER=openai

# ==================== 网络搜索配置 ====================
# 可选值：TavilyAPI | AnspireAPI | BochaAPI
SEARCH_SWITCH=TavilyAPI
TAVILY_API_KEY=
TAVILY_BASE_URL=https://api.tavily.com/search

BOCHA_API_KEY=
BOCHA_BASE_URL=https://api.bocha.cn/v1/ai-search

ANSPIRE_API_KEY=
ANSPIRE_BASE_URL=https://plugin.anspire.cn/api/ntsearch/search

# ==================== 研究引擎 ====================
MAX_SECTIONS=5
MAX_CONTENT_LENGTH=500000
SEARCH_CONTENT_MAX_LENGTH=20000
SEARCH_TIMEOUT=240

# ==================== 报告输出目录 ====================
OUTPUT_DIR=data/report
HOST_REPORT_DIR=data/report/host
INSIGHT_REPORT_DIR=data/report/insight
MEDIA_REPORT_DIR=data/report/media

# ==================== Insight 向量检索(可选，需 Milvus + uv sync --extra ml) ====================
INSIGHT_VECTOR_ENABLED=false
MILVUS_URI=http://localhost:19530
MILVUS_DB_NAME=default
MILVUS_INSIGHT_COLLECTION=insight_evidence
# 本地模型目录或 HuggingFace 模型名
INSIGHT_EMBEDDING_MODEL=BAAI/bge-m3
# cuda / cpu，留空自动
INSIGHT_EMBEDDING_DEVICE=
INSIGHT_DENSE_DIM=1024
INSIGHT_VECTOR_TOP_K=80
INSIGHT_VECTOR_FILTER_DAYS=365
INSIGHT_SYNC_BATCH_SIZE=64

# ==================== Insight 语义聚类(可选，需 sentence-transformers/scikit-learn) ====================
INSIGHT_CLUSTERING_ENABLED=false
INSIGHT_CLUSTER_MODEL=
INSIGHT_CLUSTER_MAX_RECORDS=100
INSIGHT_CLUSTER_MAX_CLUSTERS=10
INSIGHT_CLUSTER_MIN_CLUSTER_SIZE=5
